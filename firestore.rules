rules_version = '2';
// กฎของ LR / LR-chat (ยังไม่มีระบบ login ของ Firebase — ใช้ PIN แทน)
//
// messages/{id} : ข้อความแชท
// gens/{user}   : รุ่นของ PIN ปัจจุบัน + role (อ่านได้)
// pinkeys/{key} : key = SHA-256("suankularb:<ชื่อ>:<PIN>:<gen>") — get ได้เมื่อรู้ key, list ไม่ได้
// changes/{id}  : ใบอนุญาตเปลี่ยน PIN (อ่านไม่ได้) — by = key ของผู้อนุมัติ
//
// เปลี่ยน PIN ได้เมื่อ "by" เป็น key ที่ยังใช้ได้ของ (ก) เจ้าของเอง หรือ (ข) Admin
// เปลี่ยนแล้ว gen +1 → key ของ PIN เก่าใช้ไม่ได้ทันที
service cloud.firestore {
  match /databases/{database}/documents {

    function genOf(u) {
      return get(/databases/$(database)/documents/gens/$(u)).data;
    }
    // key k ยังใช้ได้ และมีสิทธิ์ตั้ง PIN ให้ u (เป็นเจ้าของเอง หรือเป็น Admin)
    function canAuthorize(k, u) {
      let kd = get(/databases/$(database)/documents/pinkeys/$(k)).data;
      let g = genOf(kd.user);
      return kd.gen == g.gen && (kd.user == u || g.role == 'admin');
    }

    match /messages/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['room', 'senderId', 'text', 'ts'])
                    && request.resource.data.room is string
                    && (request.resource.data.room == 'global' || request.resource.data.room.matches('dm_[a-z]+_[a-z]+'))
                    && request.resource.data.senderId is string
                    && request.resource.data.senderId.matches('[a-z]+')
                    && request.resource.data.text is string
                    && request.resource.data.text.size() > 0
                    && request.resource.data.text.size() <= 500
                    && request.resource.data.ts is number;
      allow delete: if true;
      allow update: if false;
    }

    match /gens/{u} {
      allow read: if true;
      // ตั้งค่าครั้งแรก (ทำครั้งเดียวต่อคน)
      allow create: if u.matches('[a-z]+')
                    && request.resource.data.keys().hasOnly(['gen', 'role', 'change'])
                    && request.resource.data.gen == 0
                    && request.resource.data.role in ['admin', 'member']
                    && request.resource.data.change == 'seed';
      // เปลี่ยน PIN: gen +1 และต้องมีใบอนุญาตในชุดเดียวกัน
      allow update: if request.resource.data.keys().hasOnly(['gen', 'role', 'change'])
                    && request.resource.data.role == resource.data.role
                    && request.resource.data.gen == resource.data.gen + 1
                    && getAfter(/databases/$(database)/documents/changes/$(request.resource.data.change)).data.user == u
                    && getAfter(/databases/$(database)/documents/changes/$(request.resource.data.change)).data.gen == request.resource.data.gen;
      allow delete: if false;
    }

    match /changes/{c} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['user', 'gen', 'by'])
                    && request.resource.data.by is string
                    && canAuthorize(request.resource.data.by, request.resource.data.user)
                    && request.resource.data.gen == genOf(request.resource.data.user).gen + 1;
      allow update, delete: if false;
    }

    match /pinkeys/{k} {
      allow get: if true;
      allow list: if false;
      allow create: if k.matches('[0-9a-f]{64}')
                    && request.resource.data.keys().hasOnly(['user', 'gen', 'change'])
                    && getAfter(/databases/$(database)/documents/gens/$(request.resource.data.user)).data.gen == request.resource.data.gen
                    && (
                      // PIN เริ่มต้น: สร้างพร้อม gens ในชุดเดียวกันเท่านั้น
                      (request.resource.data.gen == 0
                        && request.resource.data.change == 'seed'
                        && !exists(/databases/$(database)/documents/gens/$(request.resource.data.user)))
                      ||
                      // PIN ใหม่: ต้องมีใบอนุญาตที่ตรงกัน
                      (getAfter(/databases/$(database)/documents/changes/$(request.resource.data.change)).data.user == request.resource.data.user
                        && getAfter(/databases/$(database)/documents/changes/$(request.resource.data.change)).data.gen == request.resource.data.gen)
                    );
      allow update, delete: if false;
    }

    // โปรไฟล์: ทุกคนอ่านได้ / เขียนได้เมื่อมีใบอนุญาต profileEdits ที่สร้างในชุดเดียวกัน
    match /profiles/{u} {
      allow read: if true;
      allow create, update: if u.matches('[a-z]+')
                    && request.resource.data.keys().hasOnly(['photos', 'bio', 'tags', 'prompts', 'mbti', 'zodiac', 'theme', 'updatedAt', 'edit'])
                    && request.resource.data.photos is list && request.resource.data.photos.size() <= 3
                    && request.resource.data.bio is string && request.resource.data.bio.size() <= 150
                    && request.resource.data.tags is list && request.resource.data.tags.size() <= 8
                    && request.resource.data.prompts is list && request.resource.data.prompts.size() <= 3
                    && request.resource.data.mbti is string && request.resource.data.zodiac is string
                    && request.resource.data.theme is string && request.resource.data.updatedAt is number
                    && request.resource.data.edit is string
                    && !exists(/databases/$(database)/documents/profileEdits/$(request.resource.data.edit))
                    && getAfter(/databases/$(database)/documents/profileEdits/$(request.resource.data.edit)).data.user == u;
      allow delete: if false;
    }

    // ใบอนุญาตแก้โปรไฟล์: by ต้องเป็น key PIN ที่ยังใช้ได้ของเจ้าของ หรือของ Admin
    match /profileEdits/{e} {
      allow read: if false;
      allow create: if request.resource.data.keys().hasOnly(['user', 'by'])
                    && request.resource.data.user is string
                    && request.resource.data.by is string
                    && canAuthorize(request.resource.data.by, request.resource.data.user);
      allow update, delete: if false;
    }

    // ===== คลัง (inventories) + ใบอนุญาต (ops) + ประวัติ/แจ้งเตือน/วงล้อ =====
    function isAdminKey(k) {
      let kd = get(/databases/$(database)/documents/pinkeys/$(k)).data;
      let g = genOf(kd.user);
      return kd.gen == g.gen && g.role == 'admin';
    }
    function opAfter(id) {
      return getAfter(/databases/$(database)/documents/ops/$(id)).data;
    }
    // ใบอนุญาตต้องถูกสร้างในชุดเดียวกันนี้ (ใช้ซ้ำไม่ได้)
    function freshOp(id) {
      return id is string
        && !exists(/databases/$(database)/documents/ops/$(id))
        && existsAfter(/databases/$(database)/documents/ops/$(id));
    }
    function validInv(d) {
      return d.keys().hasOnly(['rose', 'received', 'coin', 'ticket', 'op'])
        && d.rose is int && d.rose >= 0
        && d.received is int && d.received >= 0
        && d.coin is int && d.coin >= 0
        && d.ticket is int && d.ticket >= 0;
    }
    function bonus(pr, item) {
      return pr.item == item ? pr.amount : 0;
    }
    function invOpOk(u, p, o, n) {
      return p.kind == 'admin'
        || (p.kind == 'gift' && p.amount is int && p.amount > 0 && p.from != p.to
            && ((u == p.from && n.rose == o.rose - p.amount && n.received == o.received && n.coin == o.coin && n.ticket == o.ticket)
             || (u == p.to && n.received == o.received + p.amount && n.rose == o.rose && n.coin == o.coin && n.ticket == o.ticket
                 && getAfter(/databases/$(database)/documents/inventories/$(p.from)).data.op == n.op)))
        // Request 1:1: ผู้ขอเสียดอกที่ใช้ได้ 5 ดอก → ผู้ถูกขอได้ "ดอกที่ได้รับจาก Member" +5 ในชุดเดียวกัน
        || (p.kind == 'request'
            && ((u == p.from && n.rose == o.rose - 5 && n.received == o.received && n.coin == o.coin && n.ticket == o.ticket)
             || (u == p.to && n.received == o.received + 5 && n.rose == o.rose && n.coin == o.coin && n.ticket == o.ticket
                 && getAfter(/databases/$(database)/documents/inventories/$(p.from)).data.op == n.op)))
        || (p.kind == 'spin' && u == p.user && p.prize is int && o.coin >= 20 && n.received == o.received
            && n.coin == o.coin - 20 + bonus(get(/databases/$(database)/documents/config/roulette).data.prizes[p.prize], 'coin')
            && n.rose == o.rose + bonus(get(/databases/$(database)/documents/config/roulette).data.prizes[p.prize], 'rose')
            && n.ticket == o.ticket + bonus(get(/databases/$(database)/documents/config/roulette).data.prizes[p.prize], 'ticket'));
    }

    match /ops/{o} {
      allow read: if false;
      allow create: if request.resource.data.by is string && (
          (request.resource.data.kind == 'admin'
            && request.resource.data.keys().hasOnly(['kind', 'by'])
            && isAdminKey(request.resource.data.by))
        || (request.resource.data.kind == 'gift'
            && request.resource.data.keys().hasOnly(['kind', 'by', 'from', 'to', 'amount'])
            && canAuthorize(request.resource.data.by, request.resource.data.from))
        || (request.resource.data.kind == 'spin'
            && request.resource.data.keys().hasOnly(['kind', 'by', 'user', 'prize'])
            && canAuthorize(request.resource.data.by, request.resource.data.user))
        // Request 1:1: ผู้ขอและผู้ถูกขอต้องเป็น Member คนละคนกัน
        || (request.resource.data.kind == 'request'
            && request.resource.data.keys().hasOnly(['kind', 'by', 'from', 'to'])
            && request.resource.data.to is string
            && request.resource.data.from != request.resource.data.to
            && genOf(request.resource.data.from).role == 'member'
            && genOf(request.resource.data.to).role == 'member'
            && canAuthorize(request.resource.data.by, request.resource.data.from)));
      allow update, delete: if false;
    }

    match /inventories/{u} {
      allow read: if true;
      allow create: if u.matches('[a-z]+')
                    && request.resource.data == {'rose': 0, 'received': 0, 'coin': 0, 'ticket': 0, 'op': 'init'};
      allow update: if validInv(request.resource.data)
                    && freshOp(request.resource.data.op)
                    && invOpOk(u, opAfter(request.resource.data.op), resource.data, request.resource.data);
      allow delete: if false;
    }

    match /logs/{l} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['userId', 'itemId', 'changeType', 'amount', 'note', 'adminNote', 'timestamp', 'op'])
                    && request.resource.data.amount is int
                    && request.resource.data.timestamp is number
                    && freshOp(request.resource.data.op);
      allow update, delete: if false;
    }

    match /notifications/{n} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['kind', 'visitorId', 'visitorName', 'visitorAvatar', 'amount', 'note', 'read', 'deleted', 'timestamp', 'op'])
                    && freshOp(request.resource.data.op);
      // อ่านแล้ว / ซ่อน เท่านั้น
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'deleted']);
      allow delete: if false;
    }

    match /config/roulette {
      allow read: if true;
      allow create, update: if request.resource.data.keys().hasOnly(['prizes', 'op'])
                    && request.resource.data.prizes is list
                    && request.resource.data.prizes.size() >= 2
                    && request.resource.data.prizes.size() <= 12
                    && freshOp(request.resource.data.op)
                    && opAfter(request.resource.data.op).kind == 'admin';
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
